# ==========================================
# 智能医疗助手 - 后端环境变量示例
# ==========================================
# 使用说明：
# 复制本文件为 .env：
#   cp .env.example .env
# 然后将下方的占位符替换为你自己的实际密钥与数据库连接配置。
# 注意：切勿将包含真实密钥的 .env 文件提交至版本库！
# ==========================================

# ---------- AI 模型与搜索配置 ----------
# 阿里云百炼 API Key 与模型配置（用于通义千问 Qwen 大模型和文本 Embedding 向量化）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
LLM_MODEL=qwen3.8-flash
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# Tavily 搜索 API Key（用于医疗知识联网实时检索）
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith 链路追踪与评估配置（可选，如不需要可设为 false）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=medical_assistant

# ---------- 数据库配置 ----------
# MySQL 数据库连接串（用于用户注册、登录认证等关系型数据存储）
# 格式: mysql+mysqlconnector://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+mysqlconnector://root:your_mysql_password@localhost:3306/medical_assistant

# PostgreSQL 数据库 - 短记忆（对话历史、LangGraph 检查点 Checkpointer）
# 注意：底层使用 psycopg_pool 连接池，URL 必须以 postgresql:// 开头（切勿写成 +psycopg）
POSTGRES_SHORT_TERM_URL=postgresql://postgres:your_pg_password@localhost:5432/smart_short

# PostgreSQL 数据库 - 长记忆（存储用户画像、既往病史、体检报告等长效记忆）
# 注意：底层使用 psycopg_pool 连接池，URL 必须以 postgresql:// 开头（切勿写成 +psycopg）
POSTGRES_LONG_TERM_URL=postgresql://postgres:your_pg_password@localhost:5432/smart_long

# PostgreSQL 数据库 - 会话管理（对话会话列表、历史记录 ORM 映射）
# 注意：底层使用 SQLAlchemy ORM，驱动必须是 postgresql+psycopg:// 格式
POSTGRES_SESSION_URL=postgresql+psycopg://postgres:your_pg_password@localhost:5432/smart_session

# ---------- 应用安全与 JWT 配置 ----------
# JWT Token 加密密钥（生产环境请务必生成并使用高强度随机密钥）
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
# Token 有效期（单位：分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=525600

# ---------- 服务监听配置 ----------
HOST=0.0.0.0
PORT=8000
